APP_ENV=local
APP_NAME=안심홍보계약 API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_BASE_URL=http://localhost:3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=contracts
SUPABASE_MODE=mock
SUPABASE_MOCK_STORAGE_ACCESS_BASE_URL=http://localhost:8000/api/v1/_mock/storage

DOCUMENT_MAX_SIZE_MIB=20
DOCUMENT_MAX_PDF_PAGES=100
DEMO_OWNER_ID=00000000-0000-4000-8000-000000000013
DEMO_CONTRACT_ID=00000000-0000-4000-8000-000000000041
DEMO_BEARER_TOKEN=local-demo-owner-token
PUBLIC_TOKEN_SECRET=local-development-public-token-secret-change-before-production

UPSTAGE_MODE=mock
UPSTAGE_API_KEY=
UPSTAGE_BASE_URL=https://api.upstage.ai
UPSTAGE_PARSE_TIMEOUT_SECONDS=120
UPSTAGE_EXTRACT_TIMEOUT_SECONDS=180
UPSTAGE_EXTRACT_MODEL=information-extract
UPSTAGE_SOLAR_TIMEOUT_SECONDS=120
UPSTAGE_SOLAR_MODEL=solar-pro3

# Run `python -m app.workers.analysis_recovery --once` or a separate worker loop.
ANALYSIS_RECOVERY_BATCH_SIZE=10
ANALYSIS_RECOVERY_STALE_AFTER_SECONDS=60
ANALYSIS_RECOVERY_PROCESSING_TIMEOUT_SECONDS=14400
ANALYSIS_RECOVERY_INTERVAL_SECONDS=30

MODUSIGN_MODE=mock
MODUSIGN_ACCOUNT_EMAIL=
MODUSIGN_API_KEY=
# Optional. Configure an HTTPS frontend URL in deployed environments.
MODUSIGN_EMBEDDED_REDIRECT_URL=
# Windows local default is C:\\Windows\\Fonts\\malgun.ttf. Configure a Korean TTF path in production.
AGREEMENT_PDF_FONT_PATH=
MODUSIGN_WEBHOOK_SECRET=
