# 공개 API 주소만 브라우저 번들에 포함합니다. API 키·비밀값은 절대 넣지 않습니다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# false이면 P0 화면과 광고효과 기록·대조 화면이 FastAPI를 호출합니다.
# 로컬 API를 함께 실행하지 않을 때는 true를 사용합니다.
NEXT_PUBLIC_USE_MOCK=true

# 운영 소유자 회원가입·로그인용 공개 설정입니다. publishable(또는 legacy anon) 키만 사용합니다.
# Supabase service_role/secret 키는 절대 NEXT_PUBLIC_ 변수로 만들지 마세요.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 로컬 SUPABASE_MODE=mock API 검증 전용 토큰입니다. 운영 API 키나 서비스 키를 넣지 마세요.
# 운영에서는 비워 두고 Supabase 로그인 세션을 사용합니다.
NEXT_PUBLIC_DEMO_BEARER_TOKEN=local-demo-owner-token
