{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansim-contract.local/schemas/extracted-term.schema.json",
  "title": "ExtractedTerm",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_id",
    "document_id",
    "source_type",
    "field",
    "value_type",
    "value",
    "source_page",
    "source_text",
    "confidence",
    "verification_status"
  ],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "contract_id": {"type": "string", "format": "uuid"},
    "document_id": {"type": "string", "format": "uuid"},
    "source_type": {
      "type": "string",
      "enum": ["CONTRACT_DOCUMENT", "DOCUMENTED_EXPLANATION"]
    },
    "field": {
      "type": "string",
      "enum": [
        "contract_party_owner",
        "contract_party_agency",
        "contract_signed_date",
        "contract_start_date",
        "contract_end_date",
        "monthly_amount",
        "contract_total_amount",
        "payment_method",
        "auto_renewal",
        "contract_renewal_type",
        "termination_notice_date",
        "early_termination_allowed",
        "termination_penalty_rate",
        "refund_condition",
        "advertising_channel",
        "content_type",
        "content_quantity",
        "deliverable_due_date",
        "posting_frequency",
        "reporting_frequency",
        "performance_guarantee",
        "advertising_account_ownership",
        "content_ownership",
        "shooting_safety",
        "portrait_rights",
        "personal_information_handling",
        "facility_damage_liability",
        "false_advertising_liability"
      ]
    },
    "value_type": {
      "type": "string",
      "enum": ["TEXT", "DATE", "MONEY_KRW", "INTEGER", "PERCENT", "BOOLEAN"]
    },
    "value": {},
    "source_page": {"type": ["integer", "null"], "minimum": 1},
    "source_text": {"type": ["string", "null"], "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "NOT_FOUND", "MISSING_EVIDENCE", "NEEDS_CHECK"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "field": {
            "enum": ["monthly_amount", "contract_total_amount"]
          }
        }
      },
      "then": {"properties": {"value_type": {"const": "MONEY_KRW"}}}
    },
    {
      "if": {
        "properties": {
          "field": {
            "enum": [
              "contract_signed_date",
              "contract_start_date",
              "contract_end_date",
              "termination_notice_date",
              "deliverable_due_date"
            ]
          }
        }
      },
      "then": {"properties": {"value_type": {"const": "DATE"}}}
    },
    {
      "if": {
        "properties": {
          "field": {
            "enum": ["auto_renewal", "early_termination_allowed"]
          }
        }
      },
      "then": {"properties": {"value_type": {"const": "BOOLEAN"}}}
    },
    {
      "if": {"properties": {"field": {"const": "content_quantity"}}},
      "then": {"properties": {"value_type": {"const": "INTEGER"}}}
    },
    {
      "if": {"properties": {"field": {"const": "termination_penalty_rate"}}},
      "then": {"properties": {"value_type": {"const": "PERCENT"}}}
    },
    {
      "if": {"properties": {"value_type": {"const": "TEXT"}}},
      "then": {"properties": {"value": {"type": ["string", "null"]}}}
    },
    {
      "if": {"properties": {"field": {"const": "contract_renewal_type"}}},
      "then": {
        "properties": {
          "value": {
            "type": ["string", "null"],
            "enum": ["AUTO", "MANUAL", "NONE", "UNKNOWN", null]
          }
        }
      }
    },
    {
      "if": {"properties": {"value_type": {"const": "DATE"}}},
      "then": {"properties": {"value": {"type": ["string", "null"], "format": "date"}}}
    },
    {
      "if": {"properties": {"value_type": {"const": "MONEY_KRW"}}},
      "then": {
        "properties": {
          "value": {"type": ["integer", "null"], "format": "int64", "minimum": 0}
        }
      }
    },
    {
      "if": {"properties": {"value_type": {"const": "INTEGER"}}},
      "then": {"properties": {"value": {"type": ["integer", "null"], "minimum": 0}}}
    },
    {
      "if": {"properties": {"value_type": {"const": "PERCENT"}}},
      "then": {
        "properties": {
          "value": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}
        }
      }
    },
    {
      "if": {"properties": {"value_type": {"const": "BOOLEAN"}}},
      "then": {
        "properties": {
          "value": {
            "type": ["string", "null"],
            "enum": ["YES", "NO", "UNKNOWN", null]
          }
        }
      }
    },
    {
      "if": {"properties": {"verification_status": {"const": "VERIFIED"}}},
      "then": {
        "properties": {
          "source_page": {"type": "integer", "minimum": 1},
          "source_text": {"type": "string", "minLength": 1},
          "value": {"not": {"type": "null"}}
        }
      }
    },
    {
      "if": {"properties": {"verification_status": {"const": "NOT_FOUND"}}},
      "then": {
        "properties": {
          "source_page": {"type": "null"},
          "source_text": {"type": "null"},
          "value": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"verification_status": {"const": "MISSING_EVIDENCE"}}},
      "then": {
        "properties": {
          "source_page": {"type": "null"},
          "source_text": {"type": "null"},
          "value": {"not": {"type": "null"}}
        }
      }
    },
    {
      "if": {"properties": {"verification_status": {"const": "NEEDS_CHECK"}}},
      "then": {
        "properties": {
          "source_page": {"type": "integer", "minimum": 1},
          "source_text": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "field": {
            "enum": [
              "auto_renewal",
              "early_termination_allowed",
              "contract_renewal_type"
            ]
          },
          "value": {"const": "UNKNOWN"}
        }
      },
      "then": {
        "properties": {
          "verification_status": {"const": "NEEDS_CHECK"}
        }
      }
    }
  ]
}
