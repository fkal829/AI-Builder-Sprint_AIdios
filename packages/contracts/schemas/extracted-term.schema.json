{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansim-contract.local/schemas/extracted-term.schema.json",
  "title": "ExtractedTerm",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "field",
    "value",
    "source_page",
    "source_text",
    "confidence",
    "verification_status"
  ],
  "properties": {
    "field": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "source_page": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "source_text": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "NOT_FOUND", "MISSING_EVIDENCE", "NEEDS_CHECK"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_status": {"const": "VERIFIED"}
        }
      },
      "then": {
        "properties": {
          "source_page": {"type": "integer", "minimum": 1},
          "source_text": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {"const": "NOT_FOUND"}
        }
      },
      "then": {
        "properties": {
          "source_page": {"type": "null"},
          "source_text": {"type": "null"}
        }
      }
    }
  ]
}
