{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansim-contract.local/schemas/extracted-term.schema.json",
  "title": "ExtractedTerm",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "field",
    "value",
    "sourcePage",
    "sourceText",
    "confidence"
  ],
  "properties": {
    "field": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "sourcePage": {
      "type": "integer",
      "minimum": 1
    },
    "sourceText": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
