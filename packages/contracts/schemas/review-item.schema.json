{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansim-contract.local/schemas/review-item.schema.json",
  "title": "ReviewItem",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "contract_id",
    "type",
    "severity",
    "detection_method",
    "model_confidence",
    "model_limitations",
    "plain_explanation",
    "basis_type",
    "basis_text",
    "basis_citation",
    "related_extracted_term_ids",
    "source_document_id",
    "source_page",
    "source_text",
    "source_confidence",
    "verification_status",
    "suggestion_accept",
    "suggestion_compromise",
    "suggestion_request",
    "user_choice",
    "status"
  ],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "contract_id": {"type": "string", "format": "uuid"},
    "type": {
      "type": "string",
      "enum": ["MISMATCH", "NO_BASIS", "UNCLEAR", "MISSING", "NEEDS_CHECK"]
    },
    "severity": {"type": "string", "enum": ["INFO", "CHECK", "IMPORTANT"]},
    "detection_method": {
      "type": "string",
      "enum": ["DETERMINISTIC", "MODEL", "HYBRID"]
    },
    "model_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "model_limitations": {"type": ["string", "null"], "minLength": 1},
    "plain_explanation": {"type": "string", "minLength": 1},
    "basis_type": {
      "type": "string",
      "enum": ["OFFICIAL_SOURCE", "INTERNAL_RULE"]
    },
    "basis_text": {"type": "string", "minLength": 1},
    "basis_citation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization",
            "document_title",
            "url",
            "version",
            "effective_date"
          ],
          "properties": {
            "organization": {"type": "string", "minLength": 1},
            "document_title": {"type": "string", "minLength": 1},
            "url": {"type": ["string", "null"], "format": "uri", "pattern": "^https?://"},
            "version": {"type": ["string", "null"], "minLength": 1},
            "effective_date": {"type": ["string", "null"], "format": "date"}
          }
        },
        {"type": "null"}
      ]
    },
    "related_extracted_term_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uuid"}
    },
    "source_document_id": {"type": ["string", "null"], "format": "uuid"},
    "source_page": {"type": ["integer", "null"], "minimum": 1},
    "source_text": {"type": ["string", "null"], "minLength": 1},
    "source_confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "verification_status": {
      "type": "string",
      "enum": ["VERIFIED", "NOT_FOUND", "MISSING_EVIDENCE", "NEEDS_CHECK"]
    },
    "suggestion_accept": {"type": "string", "minLength": 1},
    "suggestion_compromise": {"type": "string", "minLength": 1},
    "suggestion_request": {"type": "string", "minLength": 1},
    "user_choice": {
      "type": ["string", "null"],
      "enum": ["ACCEPT", "COMPROMISE", "REQUEST", null]
    },
    "status": {
      "type": "string",
      "enum": ["UNREVIEWED", "SELECTED", "SENT", "RESOLVED", "KEPT_ORIGINAL"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "detection_method": {"enum": ["MODEL", "HYBRID"]}
        }
      },
      "then": {"properties": {"model_confidence": {"type": "number"}}}
    },
    {
      "if": {
        "properties": {
          "detection_method": {"const": "DETERMINISTIC"}
        }
      },
      "then": {
        "properties": {
          "model_confidence": {"type": "null"},
          "model_limitations": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "detection_method": {"enum": ["MODEL", "HYBRID"]}
        }
      },
      "then": {
        "properties": {
          "model_limitations": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"basis_type": {"const": "OFFICIAL_SOURCE"}}},
      "then": {"properties": {"basis_citation": {"type": "object"}}}
    },
    {
      "if": {"properties": {"basis_type": {"const": "INTERNAL_RULE"}}},
      "then": {"properties": {"basis_citation": {"type": "null"}}}
    },
    {
      "oneOf": [
        {
          "properties": {
            "source_document_id": {"type": "string", "format": "uuid"},
            "source_page": {"type": "integer", "minimum": 1},
            "source_text": {"type": "string", "minLength": 1},
            "source_confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        {
          "properties": {
            "source_document_id": {"type": "null"},
            "source_page": {"type": "null"},
            "source_text": {"type": "null"},
            "source_confidence": {"type": "null"}
          }
        }
      ]
    },
    {
      "if": {"properties": {"verification_status": {"const": "VERIFIED"}}},
      "then": {
        "properties": {
          "source_document_id": {"type": "string", "format": "uuid"},
          "source_page": {"type": "integer", "minimum": 1},
          "source_text": {"type": "string", "minLength": 1},
          "source_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    {
      "if": {"properties": {"verification_status": {"const": "NEEDS_CHECK"}}},
      "then": {
        "properties": {
          "source_document_id": {"type": "string", "format": "uuid"},
          "source_page": {"type": "integer", "minimum": 1},
          "source_text": {"type": "string", "minLength": 1},
          "source_confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_status": {"enum": ["NOT_FOUND", "MISSING_EVIDENCE"]}
        }
      },
      "then": {
        "properties": {
          "source_document_id": {"type": "null"},
          "source_page": {"type": "null"},
          "source_text": {"type": "null"},
          "source_confidence": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "UNREVIEWED"}}},
      "then": {"properties": {"user_choice": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["SELECTED", "SENT", "RESOLVED", "KEPT_ORIGINAL"]}
        }
      },
      "then": {
        "properties": {
          "user_choice": {
            "type": "string",
            "enum": ["ACCEPT", "COMPROMISE", "REQUEST"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"enum": ["SELECTED", "SENT", "KEPT_ORIGINAL"]}
        }
      },
      "then": {
        "properties": {
          "user_choice": {
            "type": "string",
            "enum": ["COMPROMISE", "REQUEST"]
          }
        }
      }
    }
  ]
}
